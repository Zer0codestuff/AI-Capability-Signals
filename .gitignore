# Raw source snapshots and intermediate frames are reproducible from the source registry and
# are far too large to version. Their SHA-256 digests are recorded in report/run_manifest.json,
# so a reviewer can verify that a rerun saw identical inputs without the bytes being in git.
data/raw/
data/interim/
data/sample/

# Published analysis tables are versioned so findings can be reviewed without a full rerun.
# The exclusions below are tables that are large by nature.
data/analysis/*.parquet

*.tmp
*.part
node_modules/
dist/
coverage/
*.tsbuildinfo
artifacts/
data/snapshots/
